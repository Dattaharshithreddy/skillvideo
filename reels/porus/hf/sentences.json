[
 {
  "para": 0,
  "start": 0.35,
  "end": 2.253,
  "text": "క్రీస్తు పూర్వం… మూడొందల ఇరవై ఆరు."
 },
 {
  "para": 0,
  "start": 2.553,
  "end": 7.342,
  "text": "పర్షియా సామ్రాజ్యాన్నే కూల్చేసిన అలెగ్జాండర్… భారతదేశం గడప దగ్గర నిలబడ్డాడు."
 },
 {
  "para": 0,
  "start": 7.642,
  "end": 10.501,
  "text": "దారిలో ఉన్న రాజులంతా తలవంచారు… ఒక్కడు తప్ప."
 },
 {
  "para": 0,
  "start": 10.801,
  "end": 12.743,
  "text": "జీలం నది అవతల… పౌరవ రాజు, పురు."
 },
 {
  "para": 0,
  "start": 13.043,
  "end": 14.653,
  "text": "మనం పురుషోత్తముడు అంటాం."
 },
 {
  "para": 0,
  "start": 14.953,
  "end": 16.66,
  "text": "గ్రీకులు పోరస్ అని రాశారు."
 },
 {
  "para": 1,
  "start": 17.01,
  "end": 20.381,
  "text": "కప్పం కట్టి లొంగిపొమ్మని అలెగ్జాండర్ కబురు పంపాడు."
 },
 {
  "para": 1,
  "start": 20.681,
  "end": 23.166,
  "text": "పురు జవాబు ఒక్కటే… సరిహద్దులోనే కలుద్దాం."
 },
 {
  "para": 1,
  "start": 23.466,
  "end": 24.298,
  "text": "కానీ ఆయుధాలతో!"
 },
 {
  "para": 2,
  "start": 24.648,
  "end": 28.52,
  "text": "కానీ పురుకి మొదటి దెబ్బ కొట్టింది విదేశీయుడు కాదు… పొరుగు రాజే."
 },
 {
  "para": 2,
  "start": 28.82,
  "end": 29.954,
  "text": "తక్షశిల రాజు అంభి."
 },
 {
  "para": 2,
  "start": 30.254,
  "end": 33.692,
  "text": "పురు మీద పాత పగతో, అలెగ్జాండర్‌కి కోట తలుపులు తెరిచాడు."
 },
 {
  "para": 2,
  "start": 33.992,
  "end": 34.927,
  "text": "సైన్యాన్ని కూడా ఇచ్చాడు."
 },
 {
  "para": 3,
  "start": 35.277,
  "end": 37.709,
  "text": "అలా అలెగ్జాండర్ జీలం నది ఒడ్డుకు చేరాడు."
 },
 {
  "para": 3,
  "start": 38.009,
  "end": 40.156,
  "text": "వర్షాలకు నది ఉప్పొంగి ప్రవహిస్తోంది."
 },
 {
  "para": 3,
  "start": 40.456,
  "end": 43.891,
  "text": "అవతలి ఒడ్డున పురు సైన్యం… ముందు వరుసలో యుద్ధ ఏనుగులు!"
 },
 {
  "para": 3,
  "start": 44.191,
  "end": 47.466,
  "text": "ఏనుగుల్ని చూస్తేనే గ్రీకు గుర్రాలు బెదిరిపోతాయి."
 },
 {
  "para": 3,
  "start": 47.766,
  "end": 49.472,
  "text": "ఎదురుగా నది దాటడం అసాధ్యం."
 },
 {
  "para": 4,
  "start": 49.822,
  "end": 52.137,
  "text": "అందుకే అలెగ్జాండర్ ఒక ఎత్తు వేశాడు."
 },
 {
  "para": 4,
  "start": 52.437,
  "end": 56.053,
  "text": "రాత్రి రాత్రీ ఒడ్డున అటూ ఇటూ గుర్రాలను పరుగెత్తించాడు."
 },
 {
  "para": 4,
  "start": 56.353,
  "end": 58.988,
  "text": "అరుపులు, కాగడాలు… ఇప్పుడే దాడి అన్నట్టు."
 },
 {
  "para": 4,
  "start": 59.288,
  "end": 61.976,
  "text": "పురు సైన్యం ప్రతిసారీ లేచి సిద్ధమయ్యేది."
 },
 {
  "para": 4,
  "start": 62.276,
  "end": 65.156,
  "text": "చివరికి అలసిపోయి… పట్టించుకోవడం మానేసింది."
 },
 {
  "para": 5,
  "start": 65.506,
  "end": 67.725,
  "text": "ఒక రాత్రి… ఉరుములు, మెరుపులు, కుండపోత వాన."
 },
 {
  "para": 5,
  "start": 68.025,
  "end": 71.844,
  "text": "ఆ తుఫాను చప్పుడులో, అలెగ్జాండర్ నది ఎగువకు వెళ్ళి, రహస్యంగా నది దాటాడు."
 },
 {
  "para": 5,
  "start": 72.144,
  "end": 75.866,
  "text": "తెల్లవారి చూస్తే… అది అవతలి ఒడ్డు కాదు, నది మధ్యలో ఒక దీవి!"
 },
 {
  "para": 5,
  "start": 76.166,
  "end": 78.545,
  "text": "ఛాతీ లోతు నీళ్లలో మళ్ళీ నడిచి దాటారు."
 },
 {
  "para": 6,
  "start": 78.895,
  "end": 81.693,
  "text": "వాళ్ళని ఆపడానికి పురు తన కొడుకుని రథాలతో పంపాడు."
 },
 {
  "para": 6,
  "start": 81.993,
  "end": 83.646,
  "text": "కానీ వర్షానికి నేలంతా బురద."
 },
 {
  "para": 6,
  "start": 83.946,
  "end": 85.436,
  "text": "రథ చక్రాలు కూరుకుపోయాయి."
 },
 {
  "para": 6,
  "start": 85.736,
  "end": 87.62,
  "text": "యువరాజు ఆ పోరులోనే నేలకొరిగాడు."
 },
 {
  "para": 7,
  "start": 87.97,
  "end": 89.634,
  "text": "అయినా పురు వెనకడుగు వేయలేదు."
 },
 {
  "para": 7,
  "start": 89.934,
  "end": 91.716,
  "text": "ఏనుగుల్ని ముందుకు నడిపించాడు."
 },
 {
  "para": 7,
  "start": 92.016,
  "end": 95.888,
  "text": "ఒకవైపు కొండల్లాంటి ఏనుగులు, మరోవైపు పొడవాటి మాసిడోనియన్ బల్లాలు."
 },
 {
  "para": 7,
  "start": 96.188,
  "end": 98.044,
  "text": "మావటీలను గురి చూసి కొట్టారు."
 },
 {
  "para": 7,
  "start": 98.344,
  "end": 101.683,
  "text": "గాయపడిన ఏనుగులు బెదిరి, సొంత సైన్యం మీదకే తిరిగాయి."
 },
 {
  "para": 7,
  "start": 101.983,
  "end": 105.503,
  "text": "అలెగ్జాండర్ జీవితంలోనే అత్యంత కఠినమైన యుద్ధాల్లో ఇదొకటి."
 },
 {
  "para": 8,
  "start": 105.853,
  "end": 108.699,
  "text": "ఒంటి నిండా గాయాలు… అయినా పురు చివరి వరకూ పోరాడాడు."
 },
 {
  "para": 8,
  "start": 108.999,
  "end": 111.325,
  "text": "బందీగా అలెగ్జాండర్ ముందు నిలబెట్టారు."
 },
 {
  "para": 8,
  "start": 111.625,
  "end": 114.43,
  "text": "నిన్ను ఎలా చూడాలి, అని అడిగాడు అలెగ్జాండర్."
 },
 {
  "para": 8,
  "start": 114.73,
  "end": 118.709,
  "text": "పురు తల ఎత్తి అన్నాడు… ఒక రాజు, ఇంకో రాజుని ఎలా చూస్తాడో… అలా."
 },
 {
  "para": 9,
  "start": 119.059,
  "end": 121.139,
  "text": "ఆ మాటకి అలెగ్జాండర్ ముగ్ధుడయ్యాడు."
 },
 {
  "para": 9,
  "start": 121.439,
  "end": 124.788,
  "text": "పురు రాజ్యాన్ని పురుకే తిరిగిచ్చాడు… ఇంకా పెద్దది చేసి."
 },
 {
  "para": 9,
  "start": 125.088,
  "end": 129.409,
  "text": "కొన్నాళ్ళకే, అలసిపోయిన గ్రీకు సైన్యం బియాస్ నది దగ్గర ఆగిపోయింది."
 },
 {
  "para": 9,
  "start": 129.709,
  "end": 132.706,
  "text": "ఇంకా ముందుకు వెళ్ళేది లేదని తేల్చి చెప్పింది."
 },
 {
  "para": 10,
  "start": 133.056,
  "end": 134.477,
  "text": "కానీ కథ అక్కడ ముగియలేదు."
 },
 {
  "para": 10,
  "start": 134.777,
  "end": 138.924,
  "text": "అలెగ్జాండర్ చనిపోయాక, అతని సేనాని యూడెమస్… మోసంతో పురుని హత్య చేశాడు."
 },
 {
  "para": 11,
  "start": 139.274,
  "end": 140.394,
  "text": "పొరుగువాడి ద్రోహం."
 },
 {
  "para": 11,
  "start": 140.694,
  "end": 141.483,
  "text": "చీకట్లో మోసం."
 },
 {
  "para": 11,
  "start": 141.783,
  "end": 143.063,
  "text": "చివరికి కుట్రతో మరణం."
 },
 {
  "para": 11,
  "start": 143.363,
  "end": 146.369,
  "text": "అయినా చరిత్ర పురుని ఒక్క మాటతో గుర్తుంచుకుంది…"
 },
 {
  "para": 11,
  "start": 148.069,
  "end": 149.413,
  "text": "ఇది… చరిత్ర చెప్పిన కథ."
 }
]